# ---------- تنظیمات پایگاه داده ----------
# ساده‌ترین راه: یک رشته‌ی اتصال کامل (اولویت دارد)
# DATABASE_URL=postgres://khodro_panel:password@127.0.0.1:5432/khodrochare_panel
DB_NAME=khodrochare_crm
DB_USER=khodrochare
DB_PASSWORD=khodrochare-strong-password
DB_PORT=5432

# ---------- API ----------
API_PORT=4000
JWT_SECRET=یک-کلید-تصادفی-طولانی-و-امن-جایگزین-کنید
JWT_EXPIRES_IN=12h
APP_TIMEZONE=Asia/Tehran

# حساب مدیر اولیه (فقط بار اول که دیتابیس خالی است ساخته می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ساخت داده‌ی نمونه هنگام بالا آمدن سرویس (برای دمو: true)
AUTO_SEED=false

# دامنه‌های مجاز CORS (با کاما جدا کنید؛ خالی = همه)
CORS_ORIGINS=

# ---------- امنیت ورود (اختیاری — مقادیر پیش‌فرض امن است) ----------
# تعداد رمز اشتباه تا قفل موقت حساب اپراتور و مدت قفل (دقیقه)
LOGIN_ACCOUNT_MAX_FAILURES=5
LOGIN_ACCOUNT_LOCK_MINUTES=15
# سقف تلاش ناموفق از یک شبکه / برای یک نام کاربری
LOGIN_IP_MAX_FAILURES=20
LOGIN_PAIR_MAX_FAILURES=10

# ---------- مالی: درصد سهم امدادگر بر اساس نوع بار ----------
COMMISSION_TRANSPORT=20
COMMISSION_ONSITE=30
COMMISSION_GARAGE=30

# ---------- امنیت: تله‌ی ورود (حساب ادمین فیک) ----------
# این مشخصات روی صفحه‌ی ورود نمایش داده می‌شود؛ هر ورودی با آن، IP را مسدود می‌کند
DECOY_USERNAME=admin.support
DECOY_PASSWORD=Admin@Support1404
# تعداد تلاش ناموفق برای مسدودسازی خودکار IP (۰ = غیرفعال)
AUTO_BAN_AFTER_FAILURES=12

# ---------- Web ----------
WEB_PORT=3000

# ---------- پورت‌های PM2 (مستقل از PORT بالا) ----------
PANEL_API_PORT=4100
PANEL_WEB_PORT=3100

# ---------- اجرای محلی بدون Docker ----------
# DATABASE_URL=postgres://khodrochare:khodrochare@localhost:5432/khodrochare_crm
# API_PROXY_TARGET=http://localhost:4000
