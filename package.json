{
  "name": "khodrochare-operator-panel",
  "version": "1.0.0",
  "private": true,
  "description": "CRM پنل امداد خودرویی سراسری (Next.js + Express + PostgreSQL + Docker)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces --include-workspace-root",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start:api": "npm run start --workspace backend",
    "start:web": "npm run start --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:api": "npm run test --workspace backend",
    "test:web": "npm run test --workspace frontend",
    "demo": "npm run demo --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
